# factAPI Production Stack Configuration
# Used by docker-compose.prod.yml for remote deployment (e.g., Portainer from Git)
# Usage: cp stack.env.example stack.env && edit stack.env
# stack.env is gitignored — do NOT commit real secrets

FACTAPI_ENV=production
FACTAPI_DB_PATH=/data/factapi.db
FACTAPI_API_KEY=change-me-read-key
FACTAPI_ADMIN_KEY=change-me-admin-key
FACTAPI_DEFAULT_LIMIT=100
FACTAPI_MAX_LIMIT=1000
FACTAPI_CORS_ORIGINS=*
FACTAPI_LOG_LEVEL=info
